#!/usr/bin/env tclsh
#
# Wildcard-script to monitor the memory usage of a running NaviServer instance.
# To monitor a NaviServer instance named "development", link this plugin such as:
#
#    ln /usr/share/munin/node/plugins-contrib/naviserver_memsize /etc/munin/node.d/naviserver_development_memsize
#
# To configure this plugin put something like the
# following into /etc/munin/plugin-conf.d/naviserver
#
# [naviserver_*]
#    env.url /SYSTEM/munin?t=
#
# [naviserver_development_*]
#    env.address localhost
#    env.port    8000
#    env.ssl     false
#    env.client  tcl
#

lassign [split $argv0 _] . serverName service
array set config {
  address localhost
  port    8000
  ssl     false
  client  tcl
  url     /SYSTEM/munin?t=
}

foreach n [array names config] {
  if {[info exists ::env($n)]} {
    #puts "override $n with $::env($n)"
    set config($n) $::env($n)
  }
}

#
# Field configuration table:
#
#   internal-name label draw info
#
# The draw value is one of LINE2, LINE1, LINE0.
#
set ::fieldConfig {
    vsize                         {vsize             LINE2 "Virtual memory size"}
    rss                           {rss               LINE2 "Resident memory size"}
    uss                           {uss               LINE1 "Unshared memory size"}
    pss                           {pss               LINE0 "Proportional set size"}
    swap                          {swap              LINE0 "Swap usage"}

    tcmalloc_current_allocated    {"tc current"      LINE2 "Bytes currently allocated by the application according to tcmalloc"}
    tcmalloc_heap_size            {"tc heap"         LINE2 "Total heap size obtained by tcmalloc from the operating system"}
    tcmalloc_total_physical       {"tc physical"     LINE2 "Physical memory currently used by tcmalloc"}

    tcmalloc_slack                {"tc slack"        LINE0 "Bytes held by tcmalloc but not currently allocated to the application"}
    tcmalloc_pageheap_free        {"tc pagefree"     LINE1 "Bytes in the tcmalloc page heap freelist"}
    tcmalloc_pageheap_committed   {"tc pagecommit"   LINE0 "Bytes committed in the tcmalloc page heap"}
    tcmalloc_pageheap_unmapped    {"tc unmapped"     LINE0 "Bytes in the tcmalloc page heap returned/unmapped to the operating system"}

    tcmalloc_central_free         {"tc central"      LINE0 "Bytes in the tcmalloc central cache freelist"}
    tcmalloc_transfer_free        {"tc transfer"     LINE0 "Bytes in the tcmalloc transfer cache freelist"}
    tcmalloc_thread_free          {"tc thread"       LINE0 "Bytes in tcmalloc thread cache freelists"}
    tcmalloc_total_thread_cache   {"tc thread total" LINE0 "Total bytes currently held in tcmalloc thread caches"}
    tcmalloc_max_thread_cache     {"tc thread max"   LINE0 "Configured maximum bytes for tcmalloc thread caches"}
}


proc field_config {name} {
    if {[dict exists $::fieldConfig $name]} {
        lassign [dict get $::fieldConfig $name] label draw info
        return [dict create label $label draw $draw info $info]
    }

    #
    # Keep nsproxy values visible, since they are emitted dynamically with
    # pool and process numbers in the field name.
    #
    if {[regexp {^nsproxy:.*:(rss|vsize|uss)$} $name]} {
        return [dict create \
            label $name \
            draw  LINE1 \
            info  "Memory usage of NaviServer proxy process"]
    }

    return ""
}

proc emit_field_config {name cfg} {
    puts "$name.label [dict get $cfg label]"
    puts "$name.type GAUGE"
    puts "$name.min 0"
    puts "$name.draw [dict get $cfg draw]"

    set info [dict get $cfg info]
    if {$info ne ""} {
        puts "$name.info $info"
    }
}

proc emit_config {{content ""}} {
    global serverName

    puts "graph_title $serverName nsd size "
    puts "graph_category naviserver"
    puts "graph_info This graph shows the current memory usage for Naviserver instance $serverName"
    puts "graph_args --lower-limit 0 --base 1024"

    if {$content eq ""} {
        foreach name {vsize rss uss} {
            set cfg [field_config $name]
            if {$cfg ne ""} {
                emit_field_config $name $cfg
            }
        }
    } else {
        set seen [dict create]

        foreach line [split $content \n] {
            set line [string trim $line]
            if {[regexp {^(.*)[.]value} $line . name]} {
                if {![dict exists $seen $name]} {
                    set cfg [field_config $name]
                    if {$cfg ne ""} {
                        emit_field_config $name $cfg
                        dict set seen $name 1
                    }
                }
            }
        }
    }
}

proc fetch_values {} {
    global config service
    if {$config(client) eq "curl"} {
        set url [expr {$config(ssl) ? "https" : "http"}]://$config(address):$config(port)/$config(url)$service
        set content \n[exec curl -k $url 2> /dev/null]\n
    } else {
        if {$config(ssl)} {
            package req tls
            set f [tls::socket $config(address) $config(port)]
        } else {
            set f [socket $config(address) $config(port)]
        }
        puts $f "GET $config(url)$service HTTP/1.0\n"
        flush $f
        set content [read $f]
        close $f
    }
    return $content
}
proc emit_values {content} {
    foreach line [split $content \n] {
        global output
        set line [string trim $line]
        if {$line eq ""} {set output 1; continue}
        if {[info exists output]} {puts $line}
    }
}

#puts stderr "MUNIN_CAP_DIRTYCONFIG [info exists env(MUNIN_CAP_DIRTYCONFIG)] [array names ::env MUNIN*]"

try {
    set fetched_values [fetch_values]
} on error {errorMsg} {
    set fetched_values ""
}
if {$argv eq "config" } {
    emit_config $fetched_values
    return
} else {
    #set fetched_values [fetch_values]
    #emit_config $fetched_values
    emit_values $fetched_values
}
