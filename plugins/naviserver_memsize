#!/usr/bin/env tclsh
#
# Wildcard-script to monitor the memory usage of a running NaviServer instance.
# To monitor a NaviServer instance named "development", link this plugin such as:
#
#    ln /usr/share/munin/node/plugins-contrib/naviserver_memsize /etc/munin/node.d/naviserver_development_memsize
#
# To configure this plugin put something like the
# following into /etc/munin/plugin-conf.d/naviserver
#
# [naviserver_*]
#    env.url /SYSTEM/munin?t=
#
# [naviserver_development_*]
#    env.address localhost
#    env.port    8000
#    env.ssl     false
#    env.client  tcl
#

lassign [split $argv0 _] . serverName service
array set config {
  address localhost
  port    8000
  ssl     false
  client  tcl
  url     /SYSTEM/munin?t=
}

foreach n [array names config] {
  if {[info exists ::env($n)]} {
    #puts "override $n with $::env($n)"
    set config($n) $::env($n)
  }
}

proc emit_field_config {name} {
    array set fieldInfo {
        vsize                       "Virtual memory size"
        rss                         "Resident memory size"
        uss                         "Unshared memory size"
        pss                         "Proportional set size"
        swap                        "Swap usage"

        tcmalloc_current_allocated  "Bytes currently allocated by the application according to tcmalloc"
        tcmalloc_heap_size          "Total heap size obtained by tcmalloc from the operating system"
        tcmalloc_total_physical     "Physical memory currently used by tcmalloc"
        tcmalloc_pageheap_free      "Bytes in the tcmalloc page heap freelist"
        tcmalloc_pageheap_unmapped  "Bytes in the tcmalloc page heap returned/unmapped to the operating system"
    }

    array set fieldLabel {
        vsize                       "vsize"
        rss                         "rss"
        uss                         "uss"
        pss                         "pss"
        swap                        "swap"

        tcmalloc_current_allocated  "tc current"
        tcmalloc_heap_size          "tc heap"
        tcmalloc_total_physical     "tc physical"
        tcmalloc_pageheap_free      "tc pagefree"
        tcmalloc_pageheap_unmapped  "tc unmapped"
    }

    if {[info exists fieldLabel($name)]} {
        puts "$name.label $fieldLabel($name)"
    } else {
        puts "$name.label $name"
    }

    puts "$name.type GAUGE"
    puts "$name.min 0"

    if {[info exists fieldInfo($name)]} {
        puts "$name.info $fieldInfo($name)"
    }

    #
    # Keep the main RSS/size and tcmalloc correlation lines prominent.
    # More detailed allocator fields may still be recorded, but are hidden
    # from the main graph by default.
    #
    switch -- $name {
        rss -
        vsize -
        tcmalloc_current_allocated -
        tcmalloc_heap_size -
        tcmalloc_total_physical {
            puts "$name.draw LINE2"
        }

        tcmalloc_pageheap_free -
        tcmalloc_pageheap_unmapped {
            puts "$name.draw LINE1"
        }

        uss -
        pss -
        swap -
        tcmalloc_slack -
        tcmalloc_pageheap_committed -
        tcmalloc_central_free -
        tcmalloc_transfer_free -
        tcmalloc_thread_free -
        tcmalloc_total_thread_cache -
        tcmalloc_max_thread_cache {
            puts "$name.draw LINE0"
        }
    }
}

proc emit_config {{content ""}} {
    global serverName

    puts "graph_title $serverName nsd size "
    puts "graph_category naviserver"
    puts "graph_info This graph shows the current memory usage for Naviserver instance $serverName"
    puts "graph_args --lower-limit 0 --base 1024"

    if {$content eq ""} {
        foreach name {vsize rss uss} {
            emit_field_config $name
        }
    } else {
        set seen [dict create]

        foreach line [split $content \n] {
            set line [string trim $line]
            if {[regexp {^(.*)[.]value} $line . name]} {
                if {![dict exists $seen $name]} {
                    emit_field_config $name
                    dict set seen $name 1
                }
            }
        }
    }
}

proc fetch_values {} {
    global config service
    if {$config(client) eq "curl"} {
        set url [expr {$config(ssl) ? "https" : "http"}]://$config(address):$config(port)/$config(url)$service
        set content \n[exec curl -k $url 2> /dev/null]\n
    } else {
        if {$config(ssl)} {
            package req tls
            set f [tls::socket $config(address) $config(port)]
        } else {
            set f [socket $config(address) $config(port)]
        }
        puts $f "GET $config(url)$service HTTP/1.0\n"
        flush $f
        set content [read $f]
        close $f
    }
    return $content
}
proc emit_values {content} {
    foreach line [split $content \n] {
        global output
        set line [string trim $line]
        if {$line eq ""} {set output 1; continue}
        if {[info exists output]} {puts $line}
    }
}

#puts stderr "MUNIN_CAP_DIRTYCONFIG [info exists env(MUNIN_CAP_DIRTYCONFIG)] [array names ::env MUNIN*]"

try {
    set fetched_values [fetch_values]
} on error {errorMsg} {
    set fetched_values ""
}
if {$argv eq "config" } {
    emit_config $fetched_values
    return
} else {
    #set fetched_values [fetch_values]
    #emit_config $fetched_values
    emit_values $fetched_values
}
